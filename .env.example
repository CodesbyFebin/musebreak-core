# Copy to .env. Generate secrets with: openssl rand -hex 32
JWT_SECRET=change-me-to-64-hex-chars-shared-by-gateway-and-proxy
REDIS_PASSWORD=change-me
ENROLL_TOKEN=change-me
DEMO_USER=judge
DEMO_PASSWORD=musebreak
# Optional: forward /muse/query to a real endpoint you have access to (OpenAI-style chat payload)
META_MODEL_API_URL=
META_MODEL_API_KEY=
# Optional guard LLM (OpenAI-compatible, e.g. the vllm service below: http://vllm:8000/v1)
GUARD_LLM_URL=
GUARD_LLM_MODEL=
# vLLM (profile "gpu"): open-weight model id from Hugging Face
VLLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
HF_TOKEN=

# ---- Open-source Meta stack (docker-compose.open.yml) ----
# USE_OPEN_SOURCE_ONLY=true
# LLAMA_STACK_URL=http://localhost:8321
# LLAMA_STACK_API_KEY=none
# OPEN_SOURCE_MODEL_STYLE=hf
# HF ids (defaults). For local Ollama pulls you may override with ollama tags.
INFERENCE_MODEL=meta-llama/Llama-3.3-70B-Instruct
SAFETY_MODEL=meta-llama/Llama-Guard-3-8B
VISION_MODEL=meta-llama/Llama-3.2-11B-Vision-Instruct
# HF_TOKEN=   # only needed for gated HF downloads (SAM 3, some Llama repos)

# Opt-in verified local invoices: provision persistent files outside this repo.
BUSINESS_DB_PATH=
BUSINESS_SIGNING_KEY_PATH=
BUSINESS_OPERATOR_SUBJECT=
BUSINESS_ALLOWED_KEY_IDS=
# Synthetic fixtures only; keep unset/false for real business operations.
BUSINESS_ALLOW_DEMO_AUTH=false
